<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay "navigation" category: the only one allowed to draw its own screen. Only
	     applied to simulator builds (see project.yml): on a real iPhone it requires Apple's
	     approval, which a dashboard would not get. -->
	<key>com.apple.developer.carplay-maps</key>
	<true/>
</dict>
</plist>
